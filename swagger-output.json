{
  "swagger": "2.0",
  "info": {
    "title": "Movies & Actors API",
    "description": "REST API for managing a database of movies and actors.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Hello, World!"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/movies/": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "Retrieve a list of all movies from the database.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "description": "Create a new movie.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "New movie raw payload data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "Get a single movie by its unique ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Unique MongoDB ObjectId of the movie"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "description": "Update an existing movie by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Unique MongoDB ObjectId of the movie to update."
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated fields payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "description": "Delete a movie from the database by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID of the movie to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/actors/": {
      "get": {
        "tags": [
          "Actors"
        ],
        "description": "Retrieve a list of all actors from the database.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Actors"
        ],
        "description": "Create a new actor record.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "New actor raw payload data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Actor"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/actors/{id}": {
      "get": {
        "tags": [
          "Actors"
        ],
        "description": "Get a single actor by their unique ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Unique MongoDB ObjectId of the actor"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "put": {
        "tags": [
          "Actors"
        ],
        "description": "Update an existing actor by their ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID of the actor to update."
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated fields payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Actor"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      },
      "delete": {
        "tags": [
          "Actors"
        ],
        "description": "Delete an actor from the database by their ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID of the actor to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "definitions": {
    "Movie": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Inception"
        },
        "director": {
          "type": "string",
          "example": "Christopher Nolan"
        },
        "year": {
          "type": "number",
          "example": 2010
        },
        "duration": {
          "type": "number",
          "example": 148
        },
        "rating": {
          "type": "number",
          "example": 8.8
        },
        "language": {
          "type": "string",
          "example": "English"
        },
        "genre": {
          "type": "string",
          "example": "Science Fiction"
        }
      }
    },
    "Actor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Leonardo DiCaprio"
        },
        "birthdate": {
          "type": "string",
          "example": "1974-11-11"
        },
        "birthplace": {
          "type": "string",
          "example": "Los Angeles, California, USA"
        },
        "nationality": {
          "type": "string",
          "example": "American"
        },
        "awards": {
          "type": "array",
          "example": [
            "Academy Award",
            "Golden Globe"
          ],
          "items": {
            "type": "string"
          }
        },
        "popularMovies": {
          "type": "array",
          "example": [
            "Inception",
            "Titanic"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ValidationError": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "field"
              },
              "value": {
                "type": "string",
                "example": "invalid-data"
              },
              "msg": {
                "type": "string",
                "example": "Error message text."
              },
              "path": {
                "type": "string",
                "example": "fieldName"
              },
              "location": {
                "type": "string",
                "example": "body"
              }
            }
          }
        }
      }
    },
    "GeneralError": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Error description message."
        }
      }
    }
  }
}